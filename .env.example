# Core
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database Configuration (Host, Port, DB Name, User, Password)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invertio_demo
DB_USER=postgres
DB_PASSWORD=replace-with-password
DB_SSL=false

# Auth
JWT_SECRET=replace-with-64-char-random-string-in-prod
JWT_EXPIRES_IN=8h
COOKIE_NAME=invertio_session
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Storage (local for demo)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
PUBLIC_FILE_BASE_URL=http://localhost:4000/files

# S3 (present but unused in demo; keeps future switch trivial)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# QR verification tokens
QR_TOKEN_SECRET=replace-with-another-64-char-random-string
QR_TOKEN_TTL_DAYS=365

# Email (console for demo — writes to notification_logs, doesn't send)
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Invertio Demo <no-reply@demo.local>"

# Payments (mock for demo)
PAYMENT_DRIVER=mock
HYPERPAY_BASE_URL=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=

# ZATCA (stubbed — must persist UUID/hash on invoice but never call external API)
ZATCA_ENABLED=false
ZATCA_ENVIRONMENT=sandbox
ZATCA_API_BASE_URL=
ZATCA_CSID=
ZATCA_PRIVATE_KEY_PATH=

# Business rules
VAT_RATE=0.15
TZ=Asia/Riyadh

# Logging
LOG_LEVEL=info
